# Copy this file to .env and fill in your Supabase project's values
# (Project Settings > API) to switch the app from on-device demo storage to
# a real backend. Until these are set, the app runs fully offline using
# AsyncStorage (see src/services/backend.ts).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
